local classes = require("@codegen/libs/classes")
local codegenTypes = require("./codegenTypes")
local collectForwardDeclarations = require("@codegen/libs/collectForwardDeclarations")
local collectIncludePaths = require("@codegen/libs/collectIncludePaths")
local fs = require("@std/fs")
local generateMacroBody = require("@codegen/libs/generateMacroBody")
local orderedPairs = require("@codegen/libs/orderedPairs")
local path = require("@std/path")
local process = require("@std/process")
local tableext = require("@std/tableext")

const function codegenDatatype(input: codegenTypes.CodegenInput<classes.DatatypeSchema>)
	const prelude, members = input.schema.Prelude, input.schema.Members

	const includePaths = collectIncludePaths(members)
	const forwardDeclarations = collectForwardDeclarations(members)
	const macroBody = generateMacroBody(members)

	const output = {
		"// Copyright 2026 rniraclefire o/b/o Team Fireworks Games",
		"// Part of Gargantuan, an independent game engine for Roblox developers",
		"// This Source Code Form is subject to the terms of the Mozilla Public",
		"// License, v. 2.0. If a copy of the MPL was not distributed with this",
		"// file, You can obtain one at http://mozilla.org/MPL/2.0/.",
		"",
		"// This file was procedurally @generated by Gargantuan. Do not edit!",
		"// Regenerate this file by running: `lute codegen`",
		"",
		"#pragma once",
		"",
	}

	if next(includePaths) then
		for path in orderedPairs(includePaths) do
			table.insert(output, `#include {path} // IWYU pragma: export`)
		end
		table.insert(output, "")
	end

	if next(forwardDeclarations) then
		for declaration in orderedPairs(forwardDeclarations) do
			table.insert(output, declaration .. ";")
		end
		table.insert(output, "")
	end

	table.insert(output, `#define GG_{string.upper(prelude.Name)} \\`)
	tableext.extend(output, macroBody)
	table.insert(output, "")

	fs.writeStringToFile(input.outputPath, table.concat(output, "\n"))
	process.run({ "clang-format", "-i", path.format(input.outputPath) })

	-- for key, member in members do
	-- 	if member.Kind == "ClassProperty" then
	-- 		if member.ImplementMember then
	-- 			table.insert(classMembers, `{member.Type.CType} {key} = {member.UnmodifiedValue};`)
	-- 		end
	-- 	elseif member.Kind == "ClassMethod" then
	-- 		if member.ImplementManual then
	-- 			table.insert(
	-- 				publicMembers,
	-- 				`static int {key}(lua_State* L){member.ImplementManual.CanThrow and "noexcept" or ""};`
	-- 			)
	-- 		elseif member.ImplementMethod then
	-- 			table.insert(publicMembers, `{member.ImplementMethod.ReturnType.CType} {key}();`)
	-- 		end
	-- 	end
	-- end

	-- output:line("protected: \\")
	-- for _, line in classMembers do
	-- 	output:push(line):line(" \\")
	-- end
	-- output:line("public: \\")
	-- for _, line in publicMembers do
	-- 	output:push(line):line(" \\")
	-- end
	-- output:newline()

	-- fs.writeStringToFile(input.outputPath, output:build())
end

return codegenDatatype
