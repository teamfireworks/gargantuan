local Lest = require("@lest")
local describe, it, expect = Lest.describe, Lest.it, Lest.expect

describe("Axes", function()
	it("defaults to false", function()
		local self = Axes.new()
		expect(self.Front).toBeFalsy()
		expect(self.Back).toBeFalsy()
		expect(self.Left).toBeFalsy()
		expect(self.Right).toBeFalsy()
		expect(self.Top).toBeFalsy()
		expect(self.Bottom).toBeFalsy()
		expect(self.X).toBeFalsy()
		expect(self.Y).toBeFalsy()
		expect(self.Z).toBeFalsy()
	end)

	it("constructs with Enum.NormalId", function()
		local self = Axes.new(table.unpack(Enum.NormalId:GetEnumItems()))
		expect(self.Front).toBeTruthy()
		expect(self.Back).toBeTruthy()
		expect(self.Left).toBeTruthy()
		expect(self.Right).toBeTruthy()
		expect(self.Top).toBeTruthy()
		expect(self.Bottom).toBeTruthy()
		expect(self.X).toBeTruthy()
		expect(self.Y).toBeTruthy()
		expect(self.Z).toBeTruthy()
	end)

	it("partially constructs with Enum.NormalId", function()
		local self = Axes.new(Enum.NormalId.Left, Enum.NormalId.Right, Enum.NormalId.Top)
		expect(self.Front).toBeFalsy()
		expect(self.Back).toBeFalsy()
		expect(self.Left).toBeTruthy()
		expect(self.Right).toBeTruthy()
		expect(self.Top).toBeTruthy()
		expect(self.Bottom).toBeFalsy()
		expect(self.X).toBeTruthy()
		expect(self.Y).toBeFalsy()
		expect(self.Z).toBeFalsy()
	end)
end)
