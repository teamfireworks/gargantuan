		expectVecNear(a + b, 5, 7, 9)
		expectVecNear(b - a, 3, 3, 3)
		expectVecNear(a * 2, 2, 4, 6)
		expectVecNear(2 * a, 2, 4, 6)
		expectVecNear(b / 2, 2, 2.5, 3)
		expectVecNear(-a, -1, -2, -3)
	end)

