		expect(a:Dot(b)).toBe(12)
	end)

	it("crosses orthogonality", function()
		local a = Vector3.new(1, 0, 0)
		local b = Vector3.new(0, 1, 0)
		local c = a:Cross(b)
		expect(c.X).toBe(0)
		expect(c.Y).toBe(0)
		expect(c.Z).toBe(1)
	end)

	it("applies arithmetic operators", function()
