		local v = Vector3.new()
		expect(v.X).toBe(0)
		expect(v.Y).toBe(0)
		expect(v.Z).toBe(0)
	end)

	it("constructs with arguments", function()
		local v = Vector3.new(1, 2, 3)
		expect(v.X).toBe(1)
